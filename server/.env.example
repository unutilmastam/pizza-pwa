# =============================================================================
# Pitsa Node servis — muhit o'zgaruvchilari
#
# Bu fayl NAMUNA. Haqiqiy qiymatlarni `.env` ga yozing (u .gitignore da)
# yoki Render'da Environment bo'limiga qo'ying.
# MAXFIY KALITLAR HECH QACHON KODGA YOZILMAYDI.
# =============================================================================

# --- Server ---
# Render PORT ni o'zi beradi, mahalliy ishga tushirishda 8080 ishlatiladi
PORT=8080
NODE_ENV=development

# CORS: frontend manzillari, vergul bilan ajratiladi
ALLOWED_ORIGINS=https://unutilmastam.github.io,http://127.0.0.1:8080

# --- Firebase Admin SDK ---
# Konsol → Project settings → Service accounts → Generate new private key.
# JSON fayldagi uchta qiymat:
FIREBASE_PROJECT_ID=pizza-pwa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pizza-pwa.iam.gserviceaccount.com
# Private key ko'p qatorli — qatorlarni \n bilan yozing va qo'shtirnoq ichiga oling
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"

# --- OTP ---
# console  — SMS yuborilmaydi, kod server logiga yoziladi (sinov uchun)
# eskiz    — Eskiz.uz SMS shlyuzi (ESKIZ_* to'ldirilishi shart)
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Kodni qayta yuborish taymeri (frontend'dagi OTP_RESEND_SECONDS bilan bir xil)
OTP_RESEND_SECONDS=60
# Bir raqamga soatiga nechta kod yuborish mumkin
OTP_HOURLY_LIMIT=5

# Eskiz.uz (SMS_PROVIDER=eskiz bo'lsa)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# App Store / Google Play tekshiruvchilari uchun doimiy test raqami.
# Bo'sh qoldirilsa test raqami ishlamaydi.
TEST_PHONE=
TEST_OTP_CODE=

# --- Telegram ---
# @BotFather bergan token. Bo'sh bo'lsa xabar yuborilmaydi, servis ishlayveradi.
TELEGRAM_BOT_TOKEN=
# Admin guruh yoki kanal chat_id (masalan -1001234567890)
TELEGRAM_ADMIN_CHAT_ID=

# --- Biznes qoidalari ---
# Buyurtma statusini o'zgartira oladigan uid'lar (vergul bilan)
ADMIN_UIDS=
# Kafolat (daqiqa) va cashback foizi — settings/global bo'lmasa shular ishlatiladi
GUARANTEE_MINUTES=35
CASHBACK_PERCENT=2
BONUS_EXPIRY_DAYS=90

# --- Cron ---
# Render bepul planida servis uxlaydi — cron faqat servis uyg'oq paytda ishlaydi.
# Tashqi cron (masalan cron-job.org) /api/health ga urib turishi tavsiya etiladi.
ENABLE_CRON=true
